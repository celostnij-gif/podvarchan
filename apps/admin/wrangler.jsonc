{
  "name": "podvarchan-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Explicitly empty cron list — removes the dashboard-created */10 schedule
  // (2026-08-30) that had no scheduled() handler in code and threw
  // "Handler does not export a scheduled() function" on every tick:
  // 144 scriptThrewException/day since 2026-08-30 (Workers invocations
  // analytics, 2026-09-04). The SCHEDULED post status / scheduledAt field
  // remain unused in prod D1 (0 rows). If deferred publishing is ever needed,
  // implement the scheduled handler FIRST (pattern: wrangler/worker.ts) and
  // add the schedule back here.
  "triggers": { "crons": [] },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "podvarchan-admin"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "upload_source_maps": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "podvarchan",
      "database_id": "ea2c9727-65f8-4d36-8ff1-5cfb2f4cef36",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "2f39c831b94841b3b30d7b6246c2a221"
    },
    {
      "binding": "CONTENT_CACHE_KV",
      "id": "f837cd15ed1e4262ad1566099a4c30c0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_R2_BUCKET",
      "bucket_name": "podvarchan-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "podvarchan-admin-inc-cache"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://podvarchan.com",
    "PUBLIC_SITE_URL": "https://podvarchan.com",
    "AUTH_TRUST_HOST": "true",
    "AUTH_URL": "https://admin.podvarchan.com",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAADYZ2z3RysEsBoQu",
    "CONTACT_EMAIL": "podvarchan@gmail.com"
  }
}
